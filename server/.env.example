# NexusFlow environment variables
# Copy this file to .env and fill in only the providers you use.

# Qwen-compatible API key
QWEN_API_KEY=

# OpenAI-compatible API key
OPENAI_API_KEY=

# OpenRouter API key
OPENROUTER_API_KEY=

# Local OpenAI-compatible model endpoint. Any server implementing the
# OpenAI API works here, including vLLM on an Ascend NPU (see README).
LOCAL_MODEL_URL=http://localhost:8000/v1/chat/completions

# Optional dynamic knowledge API endpoint
KNOWLEDGE_API_URL=http://localhost:5000

# Server port
PORT=5757
HOST=127.0.0.1

# Required: generate a random value with at least 32 characters.
# Example: openssl rand -base64 48
JWT_SECRET=

# Required in production: a separate random value used to encrypt each user's
# saved OpenAI-compatible API key. Keep it stable or saved keys cannot be read.
MODEL_CONFIG_ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call the API. Vercel deployment
# domains are added automatically; add a custom domain here when you attach one.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browser sessions use an HttpOnly SameSite cookie. Bearer tokens are hidden by default.
SESSION_TTL_SECONDS=43200
EXPOSE_AUTH_TOKEN=false

# Development defaults to open registration. Production defaults to false.
ALLOW_REGISTRATION=true
BCRYPT_ROUNDS=10

# Vercel: provision Turso Cloud and Upstash Redis from the Marketplace.
# Local development can leave these empty and use DATABASE_PATH plus the
# in-memory limiter. The Upstash integration may alternatively inject
# KV_REST_API_URL and KV_REST_API_TOKEN.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Keep false unless this instance intentionally needs local/private network tools.
#
# Set this to true when the model server runs on this machine or on a private
# network - for example a self-hosted vLLM instance. Only the endpoint matching
# LOCAL_MODEL_URL exactly is exempt automatically; a base URL saved through
# 模型设置 is treated as user-supplied and stays subject to the SSRF guard, so a
# private address there is rejected unless this flag is true. That path is the
# only one carrying an embedding model, which the vector features need.
ALLOW_PRIVATE_NETWORK_REQUESTS=false

# Maximum buffered response for HTTP tool and model proxy calls (bytes).
MAX_PROXY_RESPONSE_BYTES=2097152

# Vercel requests are capped below the platform's 4.5 MB request limit.
MAX_UPLOAD_BYTES=4000000

# Local database path and deprecated legacy admin pages.
DATABASE_PATH=vector_knowledge.db
ENABLE_LEGACY_ADMIN=false
